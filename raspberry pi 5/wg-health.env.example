# Copy to Portainer stack env (or a local wg-health.env that you do not commit).
# None of these are required for local logging. Healthchecks is the one that
# lets you see a failure from outside when WireGuard itself is the thing that died.

# https://healthchecks.io — create a check, period 2 min, grace 10 min.
# Paste the ping URL (https://hc-ping.com/<uuid>).
HEALTHCHECKS_URL=

# Optional push via ntfy.sh. Install the ntfy app and subscribe to this topic.
# Use a long random name so strangers cannot guess it.
NTFY_TOPIC=

# Optional: reuse signal-cron-compose.yml (must already be running on this Pi).
SIGNAL_ACCOUNT=
SIGNAL_RECIPIENT=
